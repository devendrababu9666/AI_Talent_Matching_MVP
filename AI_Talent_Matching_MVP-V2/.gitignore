# -------------------------
# Python backend ignores
# -------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite*
*.pkl
*.index

# Logs
*.log

# Uploaded / local data
uploads/
data/

# -------------------------
# Node / Next.js frontend ignores
# -------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build outputs
.next/
out/
build/

# Testing
coverage/
*.tsbuildinfo
next-env.d.ts

# Vercel deployment
.vercel

# -------------------------
# Misc / OS / IDE
# -------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -------------------------
# Prevent nested repos
# -------------------------
**/.git
